              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1964-c6aa-4c7f-8894" includeChildSelections="false"/>
              </constraints>
              <profiles>
                <profile name="Primaris Power - Summoning" typeId="ae70-4738-0161-bec0" typeName="Psychic Power" hidden="false" id="5037-9433-25d6-9901">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic>
                    <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Conjuration</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Can summon one of the following: 8x Bloodletters, 9x Pink Horrors, 7x Plaguebearers, 6x Daemonettes, 4x Flesh Hounds, 3x Flamers, 4x Nurglings, 6x Seekers.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>

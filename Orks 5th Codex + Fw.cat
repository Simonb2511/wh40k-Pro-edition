            <selectionEntry type="upgrade" import="true" name="6 - Da Krunch" hidden="false" id="795e-b1f7-c28a-fbcf" page="0" collective="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="false" id="671c-f735-851d-4d75" percentValue="false" includeChildSelections="false" includeChildForces="false"/>

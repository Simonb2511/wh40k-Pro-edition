              </constraints>
              <profiles>
                <profile name="1 - Cursed Earth" typeId="ae70-4738-0161-bec0" typeName="Psychic Power" hidden="false" id="e903-b7f9-2b83-388d">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic>
                    <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Blessing</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">Self</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">All DAEMON models with 12” of the psyker have +1 bonus to their invulnerable saves. Deep striking daemons will not scatter when arriving when the CENTER MODEL is placed within 12” of the psyker.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>

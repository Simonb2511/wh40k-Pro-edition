                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic>
                    <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Conjuration</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">6</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Summons 1x Bloodthirster, Lord of Change, Great Unclean One, or Keeper of Secrets. If successful, the invoking psyker is removed as a casualty.
MAY ONLY BE USED BY A PSYKER WITH MASTERY LEVEL 2 OR GREATER.</characteristic>
                  </characteristics>
                </profile>

      </infoLinks>
      <rules>
        <rule name="Only a squig" id="4485-dadc-fd15-ad7e" hidden="false">
          <description>A model with a bomb squig can make a Shooting attack using the following profile. Bomb squigs cannot be used to make Snap Shots, and cannot be used to attack Flyers, Flying Monstrous Creatures, or Skimmers.</description>
        </rule>
      </rules>
    </selectionEntry>

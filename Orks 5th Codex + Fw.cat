    <profile name="Bosspole" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="05a0-1d8b-08bb-4812">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit that includes at least one model with a Bosspole rolls on the Mob Rule table, you may choose to re-roll any result other than a Breaking Heads result. You must accept the result of the re-roll.</characteristic>
      </characteristics>
    </profile>

              </constraints>
              <costs>
                <cost typeId="points" name="pts" value="0"/>
              </costs>
              <profiles>
                <profile name="2 - Warpath" typeId="ae70-4738-0161-bec0" typeName="Psychic Power" hidden="false" id="a244-1364-aa58-c1ea">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic>
                    <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Blessing</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">Self</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Warpath is a blessing that targets the Psyker. Whilst the power is in effect, all models in the Psyker’s unit that have the ’Ere We Go! special rule gain +1 Attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>

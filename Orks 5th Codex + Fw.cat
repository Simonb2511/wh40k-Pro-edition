      <selectionEntryGroups>
        <selectionEntryGroup name="Warlord Trait" id="7bc0-f0db-f345-a516" hidden="false">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="1 - Prophet of the Waaagh!" hidden="false" id="8537-66a2-4fe2-0a5f">
              <rules>
                <rule name="Prophet of the Waaagh!" id="b403-09e4-68fb-c22a" hidden="false">
                  <description>All friendly models with the Waagh! special rule gain the Fearless special rule a Waaagh! is called, until the start of their next turn.</description>
                </rule>
              </rules>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4e2a-71eb-e865-951c" includeChildSelections="false"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="2 - Bellowing Tyrant" hidden="false" id="9b32-ad06-6f7a-be2b">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="533f-66b9-a87d-079e" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Bellowing Tyrant" id="94c5-cb34-cb1b-16c2" hidden="false">
                  <description>The Warlord, and all friendly units with the Orks Faction within 12&quot; of him, re-roll failed Morale checks and Pinning tests.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="3 - Like a Thunderbolt!" hidden="false" id="7ee8-8910-7282-a3f7">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="645d-99be-1509-8f2a" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Like a Thunderbolt!" id="cde4-c76f-9c73-6a4c" hidden="false">
                  <description>The Warlord, and all friendly units with the Orks Faction within 12&quot; of him, gain the move through cover special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="4 - Brutal but Kunnin’" hidden="false" id="d2e1-953f-a4ec-7f9b">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="96d1-e715-69ed-2918" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Brutal but Kunnin’" id="a907-d3d6-e2dd-e7e8" hidden="false">
                  <description>The Warlord can re-roll one failed To Hit or To Wound roll each turn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="5 - Kunnin’ but Brutal" hidden="false" id="b486-04e0-bab8-3033">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bdcb-c530-362c-9619" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Kunnin’ but Brutal" id="991c-3c78-3657-75d8" hidden="false">
                  <description>The Warlord can re-roll one failed armour or invulnerable saving throw each turn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="6 - Might is Right" hidden="false" id="2e51-f1ad-7f08-8eee">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4f93-714f-c1d2-c746" includeChildSelections="false"/>
